DCA_CRIME_SOURCE_URL=https://www.dallasopendata.com/resource/qv6i-rri7.json
DCA_CRIME_LOOKBACK_DAYS=365
# Optional: exclude singleton ZIP matches from the study universe
# DCA_MIN_TOTAL_INCIDENTS_PER_ZIP=2
DCA_CENSUS_YEAR=2024
DCA_CENSUS_STATE_FIPS=48
DCA_HOUSING_SOURCE_QUERY=site:zillow.com/home-values/ Dallas TX {zip} typical home value
# Optional: cap live Firecrawl smoke runs
# DCA_MAX_HOUSING_ZIPS=10
# Optional: Firecrawl scrape batching and acquisition resilience
# DCA_HOUSING_SCRAPE_BATCH_SIZE=5
# DCA_ACQUIRE_MAX_ATTEMPTS=3
# DCA_ACQUIRE_BACKOFF_SECONDS=1.0
# DCA_ACQUIRE_TIMEOUT_SECONDS=60
# DCA_FIRECRAWL_TIMEOUT_SECONDS=90

# Optional credentials
FIRECRAWL_API_KEY=
CENSUS_API_KEY=
